# Required
MYSQL_DSN=user:password@tcp(127.0.0.1:3306)/tofex?parseTime=true&loc=UTC
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Server
PORT=8080
GIN_MODE=debug
CORS_ORIGIN=http://localhost:3000

# Uploads (receipts + product images)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# JWT lifetime (Go duration, e.g. 24h)
JWT_EXPIRY=24h

# Password reset token lifetime
PASSWORD_RESET_EXPIRY=1h

# Dev only: include reset token in JSON response + log
LOG_PASSWORD_RESET_LINK=false
